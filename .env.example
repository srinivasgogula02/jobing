# Main Jobing Vercel project. Copy values into a gitignored local env file or
# the Vercel environment; never commit real secrets.

# Primary Clerk application. Forms redirects to these exact primary routes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_AUTHORIZED_PARTIES=https://jobing.site
# Signing secret for https://jobing.site/api/webhooks/clerk. The Clerk endpoint
# must subscribe to user.created, user.updated, and user.deleted.
CLERK_WEBHOOK_SECRET=

# Existing main application database. It remains in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protected operator/CI use only; never add this direct Postgres credential to
# Vercel. Used by npm run db:migrate:supabase:phase1.
SUPABASE_MIGRATION_URL=

# Canonical connector authorization-server origin. Required in every deployed
# environment. Previews must use their own issuer and a non-production Supabase
# project; issuer binding remains defense in depth, not permission to share prod.
OAUTH_ISSUER=https://jobing.site

# Phase 1 Forms service. The secret is server-only and must match Forms.
FORMS_SERVICE_URL=https://jobing.site/forms
# Server-side rewrite target. Local development uses http://localhost:3001 by
# default; production uses the independently deployed child project's stable alias.
FORMS_DEPLOYMENT_ORIGIN=https://jobing-forms.vercel.app
# Preview only: exact, comma-separated HTTPS /forms base URLs. Production is
# pinned to https://jobing.site/forms without this override.
FORMS_SERVICE_ALLOWED_BASE_URLS=
FORMS_INTERNAL_KEY_ID=phase1
FORMS_INTERNAL_SECRET=

# Authenticates Vercel cron delivery of durable Supabase -> Neon projections.
# Generate an independent random value of at least 32 bytes.
CRON_SECRET=
