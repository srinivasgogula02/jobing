# Fail-closed HTTP Basic authentication. Use a unique password with 24+ chars.
ADMIN_DASHBOARD_USER=
ADMIN_DASHBOARD_PASSWORD=

# Read-only PostHog API credentials. The ingest project token is not sufficient.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Sentry internal integration with project:read, event:read, and org:read only.
SENTRY_HOST=https://sentry.io
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_API_TOKEN=

# Server-only Supabase credentials for the feedback inbox. Prefer a dedicated
# restricted reader instead of the service key when that role is provisioned.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
