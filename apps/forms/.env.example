# Required in the Forms Vercel project. Forms is served through jobing.site/forms,
# so it uses the primary Jobing Clerk session without a paid satellite domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://jobing.site/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://jobing.site/sign-up
NEXT_PUBLIC_JOBING_SITE_URL=https://jobing.site
NEXT_PUBLIC_FORMS_SITE_URL=https://jobing.site/forms
# Public form GET/POST API is served directly by the Forms deployment.
NEXT_PUBLIC_FORMS_API_URL=https://forms.jobing.site/forms
CLERK_AUTHORIZED_PARTIES=https://jobing.site

# Direct jobing-forms.vercel.app URLs are deployment targets, not user-facing
# authenticated origins. Exercise authentication through the matching primary URL.

# Required at runtime. Use the least-privileged Forms runtime login on Neon.
DATABASE_URL=

# Protected operator/CI migration environment only. Initial bootstrap requires
# the direct Neon project-owner credential because it creates the SQL group roles.
# Never use a pooled endpoint or add this credential to the Forms Vercel project.
DATABASE_MIGRATION_URL=

# Required HMAC key shared only with the main jobing.site server runtime.
# Generate a random secret of at least 32 bytes independently per environment.
FORMS_INTERNAL_KEY_ID=phase1
FORMS_INTERNAL_SECRET=

# Optional during rotation. Deploy Forms with the old pair here before changing
# the main app to a new current key. Remove it after all old callers are retired.
FORMS_INTERNAL_PREVIOUS_KEY_ID=
FORMS_INTERNAL_PREVIOUS_SECRET=

# Server-only, free-tier observability. The same PostHog project and Sentry
# account can be shared across Jobing deployments; every event is tagged forms.
# No respondent browser SDK, autocapture, session replay, form values, or PII.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
# Production enables telemetry automatically. Set this only for a deliberate
# local/preview verification and remove it afterwards.
JOBING_OBSERVABILITY_ENABLED=false
# Optional; VERCEL_GIT_COMMIT_SHA is used automatically when this is empty.
SENTRY_RELEASE=
# Comma-separated exact origins used before a wildcard pages domain is attached.
PAGES_RUNTIME_ALLOWED_ORIGINS=https://jobing-pages.vercel.app
# Dedicated registrable domain whose one-label subdomains host generated pages.
PAGES_RUNTIME_ROOT_DOMAIN=jobing.online
