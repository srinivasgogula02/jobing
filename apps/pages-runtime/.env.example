SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-read-only-anon-key
# Apex and *.jobing.online must both be attached to this Vercel project.
PAGES_ROOT_DOMAIN=jobing.online

# Server-only, free-tier observability. Reuse the shared Jobing PostHog project
# and Sentry account; events are tagged pages-runtime. Successful page requests
# are sampled at 10%, while every 4xx/5xx is retained. No browser SDK or replay.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
# Production enables telemetry automatically. Set this only for a deliberate
# local/preview verification and remove it afterwards.
JOBING_OBSERVABILITY_ENABLED=false
# Optional; VERCEL_GIT_COMMIT_SHA is used automatically when this is empty.
SENTRY_RELEASE=
